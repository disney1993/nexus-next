# Copia este fichero como .env.local y rellena los valores.
# En la Actividad 1 NO hace falta ninguna variable: la app funciona con la API simulada.

# ── Auth0 (login con Google · Actividades 2/3) ──────────────────────────────
# Dominio y credenciales de la aplicación "Regular Web Application" de Auth0
AUTH0_DOMAIN=tu-tenant.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Cadena aleatoria de 32 bytes: openssl rand -hex 32
AUTH0_SECRET=
# URL base de la app (en Vercel: https://<proyecto>.vercel.app)
APP_BASE_URL=http://localhost:3000

# ── PostgreSQL (Actividades 2/3) ───────────────────────────────────────────
# DATABASE_URL=postgresql://usuario:password@host/db?sslmode=require
